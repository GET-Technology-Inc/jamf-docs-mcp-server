{
  "name": "@get-technology-inc/jamf-docs-mcp-server",
  "version": "6.0.8",
  "description": "MCP Server for accessing Jamf Documentation (learn.jamf.com)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jamf-docs-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:app-ui && tsc",
    "dev": "tsx watch src/index.ts",
    "dev:app-ui": "node scripts/dev-app-ui.mjs",
    "fixtures:app-ui": "node scripts/capture-app-fixtures.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "ALLOW_LIVE_REQUESTS=1 vitest run test/integration --exclude '**/*contracts.test.ts'",
    "test:contract": "ALLOW_LIVE_REQUESTS=1 vitest run test/integration/data-contracts.test.ts test/integration/support-kb-contracts.test.ts test/integration/concepts-contracts.test.ts",
    "test:e2e": "ALLOW_LIVE_REQUESTS=1 vitest run test/e2e",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e",
    "test:coverage": "vitest run test/unit --coverage",
    "test:inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'app-ui/**/*.ts' 'scripts/**/*.mjs'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "build:app-ui": "node scripts/build-app-ui.mjs",
    "typecheck:app-ui": "tsc --noEmit -p app-ui/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "keywords": [
    "mcp",
    "jamf",
    "documentation",
    "model-context-protocol",
    "jamf-pro",
    "jamf-school",
    "jamf-connect",
    "jamf-protect",
    "apple",
    "mdm"
  ],
  "author": "GET Technology Inc.",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "fuse.js": "^7.1.0",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.13.6",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.1.0",
    "js-yaml": "^5.4.2",
    "semantic-release": "^25.0.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./core/*": "./dist/core/*.js",
    "./platforms/node": "./dist/platforms/node/index.js"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "core/*": [
        "dist/core/*.d.ts"
      ],
      "platforms/node": [
        "dist/platforms/node/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GET-Technology-Inc/jamf-docs-mcp-server.git"
  },
  "homepage": "https://github.com/GET-Technology-Inc/jamf-docs-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/GET-Technology-Inc/jamf-docs-mcp-server/issues"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "overrides": {
    "cosmiconfig": {
      "js-yaml": "^4.3.0"
    },
    "brace-expansion": "^5.0.8"
  }
}
